<h1>Livros</h1>

<%= link_to "Novo Livro", new_book_path, id: "new-book-link" %>

<%= form_with url: books_path, method: :get do |form| %>
  <%= form.text_field :query, value: @query, placeholder: "Buscar por título" %>
  <%= form.submit "Buscar" %>
<% end %>

<table id="books">
  <thead>
    <tr>
      <th>Título</th>
      <th>Ano</th>
      <th>Autor</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr id="book-<%= book.id %>">
        <td class="title"><%= book.title %></td>
        <td class="year"><%= book.published_year %></td>
        <td class="author"><%= book.author.name %></td>
        <td>
          <%= link_to "Editar", edit_book_path(book) %>
          <%= button_to "Excluir", book_path(book), method: :delete, data: { turbo_confirm: "Tem certeza?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
