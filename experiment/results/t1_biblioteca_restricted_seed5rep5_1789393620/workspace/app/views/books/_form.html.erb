<% if book.errors.any? %>
  <div class="errors">
    <h2><%= pluralize(book.errors.count, "erro") %> impediram o salvamento:</h2>
    <ul>
      <% book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: book do |form| %>
  <div>
    <%= form.label :title, "Título" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :published_year, "Ano de publicação" %>
    <%= form.number_field :published_year %>
  </div>

  <div>
    <%= form.label :author_id, "Autor" %>
    <%= form.collection_select :author_id, Author.order(:name), :id, :name, prompt: "Selecione um autor" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
