<h1>Livros</h1>

<%= form_with url: books_path, method: :get do |form| %>
  <%= form.label :query, "Buscar por título" %>
  <%= form.text_field :query, value: params[:query] %>
  <%= form.submit "Buscar" %>
<% end %>

<p><%= link_to "Novo Livro", new_book_path %></p>

<table>
  <thead>
    <tr>
      <th>Título</th>
      <th>Ano de publicação</th>
      <th>Autor</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.published_year %></td>
        <td><%= book.author.name %></td>
        <td><%= link_to "Ver", book %></td>
        <td><%= link_to "Editar", edit_book_path(book) %></td>
        <td><%= link_to "Excluir", book, data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
