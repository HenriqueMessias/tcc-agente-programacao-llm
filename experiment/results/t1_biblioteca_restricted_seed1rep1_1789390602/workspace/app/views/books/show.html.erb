<h1><%= @book.title %></h1>

<p><strong>Ano:</strong> <%= @book.published_year %></p>
<p><strong>Autor:</strong> <%= @book.author.name %></p>

<%= link_to "Editar", edit_book_path(@book) %> |
<%= button_to "Excluir", @book, method: :delete, data: { turbo_confirm: "Tem certeza?" } %> |
<%= link_to "Voltar", books_path %>
