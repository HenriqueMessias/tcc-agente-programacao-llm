<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Workspace" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Workspace">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <nav>
      <% if logged_in? %>
        <span id="current-user"><%= current_user.email %></span>
        <%= button_to "Logout", logout_path, method: :delete, id: "logout-button" %>
      <% else %>
        <%= link_to "Cadastro", signup_path, id: "signup-link" %>
        <%= link_to "Login", login_path, id: "login-link" %>
      <% end %>
    </nav>

    <% if flash[:notice] %>
      <p id="notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p id="alert"><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
