<h1>Authors</h1>

<%= link_to "New author", new_author_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @authors.each do |author| %>
      <tr>
        <td><%= author.name %></td>
        <td><%= link_to "Show", author %></td>
        <td><%= link_to "Edit", edit_author_path(author) %></td>
        <td><%= link_to "Destroy", author, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
