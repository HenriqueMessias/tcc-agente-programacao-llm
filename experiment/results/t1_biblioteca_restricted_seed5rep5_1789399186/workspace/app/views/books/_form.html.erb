<%= form_with(model: book) do |form| %>
  <% if book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(book.errors.count, "erro") %> impediram este livro de ser salvo:</h2>
      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :published_year, "Ano de publicação" %>
    <%= form.number_field :published_year %>
  </div>

  <div>
    <%= form.label :author_id, "Autor" %>
    <%= form.collection_select :author_id, Author.order(:name), :id, :name, include_blank: true %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
