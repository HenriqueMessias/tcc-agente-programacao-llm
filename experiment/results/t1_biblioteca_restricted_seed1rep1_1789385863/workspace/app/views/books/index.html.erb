<h1>Livros</h1>

<%= link_to "Novo Livro", new_book_path, id: "new-book-link" %>

<%= form_with url: books_path, method: :get do |f| %>
  <div>
    <%= f.label :query, "Buscar por título" %>
    <%= f.text_field :query, value: params[:query] %>
    <%= f.submit "Buscar" %>
  </div>
<% end %>

<table id="books">
  <thead>
    <tr>
      <th>Título</th>
      <th>Ano de publicação</th>
      <th>Autor</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr id="book_<%= book.id %>">
        <td><%= book.title %></td>
        <td><%= book.published_year %></td>
        <td><%= book.author.name %></td>
        <td><%= link_to "Ver", book_path(book) %></td>
        <td><%= link_to "Editar", edit_book_path(book) %></td>
        <td><%= button_to "Excluir", book_path(book), method: :delete, data: { turbo_confirm: "Tem certeza?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
