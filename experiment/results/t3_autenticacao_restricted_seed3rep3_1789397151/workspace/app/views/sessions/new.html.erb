<h1>Login</h1>

<% if flash[:alert].present? %>
  <div id="login-error"><%= flash[:alert] %></div>
<% end %>

<%= form_with url: login_path, id: "login-form" do |f| %>
  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, id: "email" %>
  </div>
  <div>
    <%= f.label :password, "Senha" %>
    <%= f.password_field :password, id: "password" %>
  </div>
  <div>
    <%= f.submit "Entrar" %>
  </div>
<% end %>

<p><%= link_to "Criar conta", signup_path %></p>
