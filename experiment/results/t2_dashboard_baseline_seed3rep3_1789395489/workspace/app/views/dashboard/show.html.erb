<% content_for :title, "Dashboard de Vendas" %>

<div id="dashboard" class="dashboard">
  <header class="dashboard__header">
    <h1>Dashboard de Vendas</h1>
    <p class="dashboard__subtitle">Indicadores agregados, pedidos e distribuição por categoria.</p>
  </header>

  <section class="filter">
    <%= form_with url: dashboard_path, method: :get, id: "filter-form", local: true do |f| %>
      <div class="filter__field">
        <%= f.label :start_date, "Data inicial" %>
        <%= f.date_field :start_date, value: @start_date&.strftime("%Y-%m-%d"), name: "start_date" %>
      </div>
      <div class="filter__field">
        <%= f.label :end_date, "Data final" %>
        <%= f.date_field :end_date, value: @end_date&.strftime("%Y-%m-%d"), name: "end_date" %>
      </div>
      <div class="filter__actions">
        <%= f.submit "Filtrar" %>
        <%= link_to "Limpar", dashboard_path, class: "filter__clear" %>
      </div>
    <% end %>
  </section>

  <section class="metrics">
    <div class="metric">
      <span class="metric__label">Total de vendas</span>
      <span class="metric__value" id="metric-total"><%= number_to_currency(@total_sales, unit: "R$ ", separator: ",", delimiter: ".") %></span>
    </div>
    <div class="metric">
      <span class="metric__label">Número de pedidos</span>
      <span class="metric__value" id="metric-count"><%= @orders_count %></span>
    </div>
    <div class="metric">
      <span class="metric__label">Ticket médio</span>
      <span class="metric__value" id="metric-average"><%= number_to_currency(@average_ticket, unit: "R$ ", separator: ",", delimiter: ".") %></span>
    </div>
  </section>

  <% if @orders_count.zero? %>
    <section id="empty-state" class="empty-state">
      <h2>Nenhum pedido encontrado</h2>
      <p>Não há pedidos no período selecionado. Ajuste o filtro de datas e tente novamente.</p>
    </section>
  <% else %>
    <section class="chart-section">
      <h2>Vendas por categoria</h2>
      <div id="chart" class="chart">
        <% @category_totals.each do |category, total| %>
          <% percentage = @max_category_total.positive? ? ((total.to_d / @max_category_total) * 100).round(2) : 0 %>
          <div class="chart-bar" data-category="<%= category %>" data-value="<%= total.to_d.to_s("F") %>">
            <span class="chart-bar__label"><%= category %></span>
            <span class="chart-bar__track">
              <span class="chart-bar__fill" style="width: <%= percentage %>%;"></span>
            </span>
            <span class="chart-bar__value"><%= number_to_currency(total, unit: "R$ ", separator: ",", delimiter: ".") %></span>
          </div>
        <% end %>
      </div>
    </section>

    <section class="table-section">
      <h2>Pedidos do período</h2>
      <table id="orders-table" class="orders-table">
        <thead>
          <tr>
            <th>Categoria</th>
            <th>Data</th>
            <th class="orders-table__amount">Valor</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="order-row">
              <td class="order-category"><%= order.category %></td>
              <td class="order-date"><%= order.order_date.strftime("%d/%m/%Y") %></td>
              <td class="order-amount"><%= number_to_currency(order.amount, unit: "R$ ", separator: ",", delimiter: ".") %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="2">Total</th>
            <th class="orders-table__amount"><%= number_to_currency(@total_sales, unit: "R$ ", separator: ",", delimiter: ".") %></th>
          </tr>
        </tfoot>
      </table>
    </section>
  <% end %>
</div>
