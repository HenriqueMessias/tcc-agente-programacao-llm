<h1>Login</h1>

<% if @error.present? %>
  <div id="login-error"><%= @error %></div>
<% end %>

<%= form_with url: login_path, method: :post, id: "login-form", local: true do |f| %>
  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, id: "email", name: "email" %>
  </div>
  <div>
    <%= f.label :password, "Senha" %>
    <%= f.password_field :password, id: "password", name: "password" %>
  </div>
  <div>
    <%= f.submit "Entrar" %>
  </div>
<% end %>
