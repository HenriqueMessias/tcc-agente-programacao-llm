<!DOCTYPE html>
<html>
  <head>
    <title>Dashboard</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 24px; background: #f5f5f5; color: #222; }
      .metrics { display: flex; gap: 16px; margin-bottom: 24px; }
      .metric-card { background: #fff; padding: 16px 24px; border-radius: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
      .metric-card strong { display: block; font-size: 22px; }
      table { border-collapse: collapse; width: 100%; background: #fff; margin-bottom: 24px; }
      th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
      th { background: #2b5aa0; color: #fff; }
      form { margin-bottom: 24px; }
      #chart { display: flex; align-items: flex-end; gap: 12px; height: 160px; background: #fff; padding: 16px; }
      .chart-bar { background: #2b5aa0; width: 40px; color: #fff; text-align: center; font-size: 11px; }
      #empty-state { background: #fff3cd; padding: 16px; border-radius: 6px; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
