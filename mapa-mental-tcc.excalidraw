      "y": 731,
      "width": 640,
      "height": 18,
      "text": "FLUXO: [1] Usuário submete intenção → [2] Paperclip gera spec + usuário aprova + define budget → [3] Hermes executa loop TDD → [4] Paperclip audita e reporta",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#2b6cb0",
      "backgroundColor": "transparent",
