    {
      "angle": 0,
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "index": "a128",
      "seed": 1706909012,
      "version": 1,
      "versionNonce": 139675676,
      "isDeleted": false,
      "updated": 1780611352899,
      "link": null,
      "locked": false,
      "id": "contrib-pln-text",
      "type": "text",
      "x": 1425,
      "y": 1423,
      "width": 570,
      "height": 165,
      "text": "1. Agentic AI — Arquitetura de orquestração com loop fechado de auto-correção\n2. Constitutional AI / Guardrails — Restrições programáticas (não apenas textuais) no comportamento do agente\n3. Prompt Engineering Estruturado — SDD como forma avançada de constrained generation\n4. Avaliação de Agentes — Test Harness como métrica objetiva de sucesso, substituindo avaliação subjetiva\n5. Eficiência Computacional — Controle de orçamento de tokens; redução de desperdício via TDD\n6. Memória e Aprendizado Contínuo — Hermes com persistência de skills entre sessões",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1a202c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 0,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "boundElements": null,
      "containerId": null,
      "originalText": "1. Agentic AI — Arquitetura de orquestração com loop fechado de auto-correção\n2. Constitutional AI / Guardrails — Restrições programáticas (não apenas textuais) no comportamento do agente\n3. Prompt Engineering Estruturado — SDD como forma avançada de constrained generation\n4. Avaliação de Agentes — Test Harness como métrica objetiva de sucesso, substituindo avaliação subjetiva\n5. Eficiência Computacional — Controle de orçamento de tokens; redução de desperdício via TDD\n6. Memória e Aprendizado Contínuo — Hermes com persistência de skills entre sessões",
      "autoResize": true,
      "lineHeight": 1.25
    },
